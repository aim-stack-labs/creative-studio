.skin-purple-light .wrapper, .skin-purple-light .main-sidebar, .skin-purple-light .left-side { background-color: rgb(249, 250, 252); }

.skin-purple-light .content-wrapper, .skin-purple-light .main-footer { border-left: 1px solid rgb(210, 214, 222); }

.skin-purple-light .user-panel > .info, .skin-purple-light .user-panel > .info > a { color: rgb(68, 68, 68); }

.skin-purple-light .sidebar-menu > li { transition: border-left-color 0.3s; }

.skin-purple-light .sidebar-menu > li.header { color: rgb(132, 132, 132); background: rgb(249, 250, 252); }

.skin-purple-light .sidebar-menu > li > a { border-left: 3px solid transparent; font-weight: 600; }

.skin-purple-light .sidebar-menu > li:hover > a, .skin-purple-light .sidebar-menu > li.active > a { color: rgb(0, 0, 0); background: rgb(244, 244, 245); }

.skin-purple-light .sidebar-menu > li.active { border-left-color: rgb(96, 92, 168); }

.skin-purple-light .sidebar-menu > li.active > a { font-weight: 600; }

.skin-purple-light .sidebar-menu > li > .treeview-menu { background: rgb(244, 244, 245); }

.skin-purple-light .sidebar a { color: rgb(68, 68, 68); }

.skin-purple-light .sidebar a:hover { text-decoration: none; }

.skin-purple-light .treeview-menu > li > a { color: rgb(119, 119, 119); }

.skin-purple-light .treeview-menu > li.active > a, .skin-purple-light .treeview-menu > li > a:hover { color: rgb(0, 0, 0); }

.skin-purple-light .treeview-menu > li.active > a { font-weight: 600; }

.skin-purple-light .sidebar-form { border-radius: 3px; border: 1px solid rgb(210, 214, 222); margin: 10px; }

.skin-purple-light .sidebar-form input[type="text"], .skin-purple-light .sidebar-form .btn { box-shadow: none; background-color: rgb(255, 255, 255); border: 1px solid transparent; height: 35px; }

.skin-purple-light .sidebar-form input[type="text"] { color: rgb(102, 102, 102); border-radius: 2px 0px 0px 2px; }

.skin-purple-light .sidebar-form input[type="text"]:focus, .skin-purple-light .sidebar-form input[type="text"]:focus + .input-group-btn .btn { background-color: rgb(255, 255, 255); color: rgb(102, 102, 102); }

.skin-purple-light .sidebar-form input[type="text"]:focus + .input-group-btn .btn { border-left-color: rgb(255, 255, 255); }

.skin-purple-light .sidebar-form .btn { color: rgb(153, 153, 153); border-radius: 0px 2px 2px 0px; }

@media (min-width: 768px) {
  .skin-purple-light.sidebar-mini.sidebar-collapse .sidebar-menu > li > .treeview-menu { border-left: 1px solid rgb(210, 214, 222); }
}
